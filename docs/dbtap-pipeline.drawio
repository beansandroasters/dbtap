<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="lane-capture" value="記録(dbtap capture)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=none;strokeColor=#879596;dashed=1;fontColor=#16191F;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1110" height="180" as="geometry" /></mxCell>
    <mxCell id="src" value="&lt;b&gt;取り込み口&lt;/b&gt;&lt;br&gt;ライブ: AF_PACKET とカーネル内フィルタ&lt;br&gt;ファイル: pcap / pcapng&lt;br&gt;ミラー: VXLAN の包みを外す" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#16191F" vertex="1" parent="lane-capture"><mxGeometry x="30" y="50" width="270" height="100" as="geometry" /></mxCell>
    <mxCell id="tcp" value="&lt;b&gt;TCP の組み立て(tcp.rs)&lt;/b&gt;&lt;br&gt;シーケンス番号と確認応答番号で&lt;br&gt;因果の順に並べる。&lt;br&gt;欠落と切り詰めは明示する" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#16191F" vertex="1" parent="lane-capture"><mxGeometry x="420" y="50" width="270" height="100" as="geometry" /></mxCell>
    <mxCell id="journal" value="&lt;b&gt;ジャーナル(.dbtap)&lt;/b&gt;&lt;br&gt;接続ごと・向きごとのバイト列と時刻。&lt;br&gt;zstd で圧縮した追記型" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#16191F" vertex="1" parent="lane-capture"><mxGeometry x="810" y="50" width="270" height="100" as="geometry" /></mxCell>
    <mxCell id="lane-replay" value="再生(dbtap replay)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=none;strokeColor=#879596;dashed=1;fontColor=#16191F;container=1;collapsible=0;recursiveResize=0" vertex="1" parent="1"><mxGeometry x="0" y="250" width="1500" height="180" as="geometry" /></mxCell>
    <mxCell id="extract" value="&lt;b&gt;復元(extract.rs / pg.rs / mysql.rs)&lt;/b&gt;&lt;br&gt;要求と応答を「単位」に組み立てる。&lt;br&gt;先読みしながら 1 レコードずつ流す" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#16191F" vertex="1" parent="lane-replay"><mxGeometry x="30" y="50" width="270" height="100" as="geometry" /></mxCell>
    <mxCell id="plan" value="&lt;b&gt;計画(plan.rs / deps.rs)&lt;/b&gt;&lt;br&gt;文が触るテーブルと値から、&lt;br&gt;投げる前に終わりを待つ相手を決める" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#16191F" vertex="1" parent="lane-replay"><mxGeometry x="420" y="50" width="270" height="100" as="geometry" /></mxCell>
    <mxCell id="replay" value="&lt;b&gt;再生(replay.rs)&lt;/b&gt;&lt;br&gt;記録の接続 1 本につき 1 本の接続。&lt;br&gt;記録と同じ時刻に、同じバイト列を投げる。&lt;br&gt;待ち合いは再生先に問い合わせて解く" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#16191F" vertex="1" parent="lane-replay"><mxGeometry x="810" y="50" width="270" height="100" as="geometry" /></mxCell>
    <mxCell id="report" value="&lt;b&gt;比較と集計(report.rs)&lt;/b&gt;&lt;br&gt;記録の応答と突き合わせる。&lt;br&gt;行数・内容・エラー・応答時間" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#16191F" vertex="1" parent="lane-replay"><mxGeometry x="1200" y="50" width="270" height="100" as="geometry" /></mxCell>
    <mxCell id="wire" value="&lt;b&gt;データベースの通信&lt;/b&gt;&lt;br&gt;PostgreSQL / MySQL(平文)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#F2F3F3;strokeColor=#545B64;dashed=1;fontColor=#16191F" vertex="1" parent="1"><mxGeometry x="30" y="-130" width="270" height="60" as="geometry" /></mxCell>
    <mxCell id="target" value="&lt;b&gt;再生先のデータベース&lt;/b&gt;&lt;br&gt;記録を始めた時点のデータを持つ複製" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#F2F3F3;strokeColor=#545B64;dashed=1;fontColor=#16191F" vertex="1" parent="1"><mxGeometry x="810" y="500" width="270" height="60" as="geometry" /></mxCell>
    <mxCell id="out" value="&lt;b&gt;レポート&lt;/b&gt;&lt;br&gt;画面と JSON。複数台の分はまとめられる" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#F2F3F3;strokeColor=#545B64;dashed=1;fontColor=#16191F" vertex="1" parent="1"><mxGeometry x="1200" y="500" width="270" height="60" as="geometry" /></mxCell>
    <mxCell id="inspect" value="&lt;b&gt;要約(dbtap inspect)&lt;/b&gt;&lt;br&gt;欠落、再生できる割合、&lt;br&gt;サーバーごとの内訳" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#F2F3F3;strokeColor=#545B64;dashed=1;fontColor=#16191F" vertex="1" parent="1"><mxGeometry x="1200" y="50" width="270" height="100" as="geometry" /></mxCell>
    <mxCell id="e-wire-src" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=center;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="wire" target="src"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-src-tcp" value="パケット" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=center;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="src" target="tcp"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-tcp-journal" value="バイト列" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=center;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="tcp" target="journal"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-journal-inspect" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=center;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="journal" target="inspect"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-journal-extract" value="ジャーナル" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=left;spacingLeft=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="journal" target="extract"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-extract-plan" value="単位" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=center;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="extract" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-plan-replay" value="単位と待つ相手" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=center;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="plan" target="replay"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-replay-report" value="結果" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=center;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="replay" target="report"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-replay-target" value="要求" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=right;spacingRight=6;exitX=0.25;exitY=1;entryX=0.25;entryY=0" edge="1" parent="1" source="replay" target="target"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-target-replay" value="応答" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=left;spacingLeft=6;exitX=0.75;exitY=0;entryX=0.75;entryY=1" edge="1" parent="1" source="target" target="replay"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e-report-out" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;labelBackgroundColor=none;verticalAlign=bottom;align=center;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="report" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
  </root>
</mxGraphModel>
